{
  "name": "marketplace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant Marketplace — Customer / Merchant / Delivery",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "customer": "npm run start --workspace @marketplace/customer",
    "merchant": "npm run start --workspace @marketplace/customer",
    "delivery": "npm run start --workspace @marketplace/customer",
    "admin": "npm run start --workspace @marketplace/customer",
    "dev": "npm run customer",
    "type-check": "npm run type-check --workspace @marketplace/customer",
    "build:web": "npm run build:web --workspace @marketplace/customer",
    "check:rpc-contract": "node scripts/check-rpc-contract.mjs",
    "check:sql-migrations": "node scripts/check-sql-migrations.mjs",
    "check:edge-contract": "node scripts/check-edge-contract.mjs",
    "check:i18n": "node scripts/i18n/check-dictionary.mjs",
    "i18n:keys": "node scripts/i18n/extract-keys.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "supabase": "2.109.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@babel/core@7.29.0": "7.29.7",
    "js-yaml@3.14.2": "3.15.0",
    "js-yaml@4.1.1": "4.3.0",
    "shell-quote@1.8.3": "1.10.0",
    "undici@6.25.0": "6.27.0",
    "ws@6.2.3": "6.2.4",
    "ws@7.5.10": "7.5.11",
    "ws@8.20.0": "8.21.0"
  }
}
