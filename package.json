{
  "name": "marketplace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant Marketplace — Customer / Merchant / Delivery",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "customer": "yarn workspace @marketplace/customer start",
    "merchant": "yarn workspace @marketplace/customer start",
    "delivery": "yarn workspace @marketplace/customer start",
    "start": "yarn workspace @marketplace/customer start",
    "dev": "yarn customer",
    "typecheck": "tsc --noEmit -p apps/customer/tsconfig.json"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "dependencies": {}
}
